# Copy to .env (gitignored) for local overrides. Compose / Spring also accept these names.

# --- MySQL (ims-api) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ims?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- JWT (required strong secret in prod; reject-insecure-jwt-secret=true) ---
IMS_SECURITY_JWT_SECRET=replace-with-at-least-32-byte-random-secret!!
IMS_SECURITY_ACCESS_TOKEN_MINUTES=30
IMS_SECURITY_REFRESH_TOKEN_DAYS=14
IMS_SECURITY_MAX_FAILED_LOGINS=5
IMS_SECURITY_LOCK_MINUTES=15
IMS_SECURITY_EXPOSE_OPENAPI=true
IMS_SECURITY_REJECT_INSECURE_JWT_SECRET=false

# --- Object storage (MinIO local / S3 prod) ---
IMS_STORAGE_ENDPOINT=http://localhost:9000
IMS_STORAGE_ACCESS_KEY=minio
IMS_STORAGE_SECRET_KEY=minio12345
IMS_STORAGE_BUCKET=ims-private

# --- Gateway auth rate limit ---
IMS_GATEWAY_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
IMS_GATEWAY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Profiles ---
# SPRING_PROFILES_ACTIVE=prod
